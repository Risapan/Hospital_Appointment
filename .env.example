# Copy to .env and change the values. docker compose reads .env automatically.
# Every value has a default in docker-compose.yml, so this file is optional for local use.

# Host ports
FRONTEND_PORT=5174
BACKEND_PORT=8081
MONGO_PORT=27018

# MongoDB (used only when the mongo_data volume is first created)
MONGO_ROOT_USER=hospital
MONGO_ROOT_PASSWORD=change_me
MONGO_DB=hospital_db

# JWT signing key: a long random hex string, e.g. from `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_hex_string

# Allowed browser origins for direct (non-proxied) API calls
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# JVM options for the backend container
JAVA_OPTS=-XX:MaxRAMPercentage=75
